# Verified existing website; change here if the final production domain changes.
PUBLIC_SITE_URL=https://keraboss.com
# Set false in EVERY public staging/preview environment. Rebuild after changing.
PUBLIC_INDEXABLE=true
# Independent training-crawler policy; search/retrieval remains allowed.
PUBLIC_GPTBOT_ALLOWED=true
# Enable only after configuring and verifying the inquiry backend and privacy policy.
PUBLIC_INQUIRY_ENABLED=false
# Server-only values configured at hosting. Never use PUBLIC_ for secrets.
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_TOKEN=
# Optional: actual Google Search Console verification token, never a placeholder.
PUBLIC_GOOGLE_SITE_VERIFICATION=

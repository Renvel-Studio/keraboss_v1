---
import Seo, { type Props as SeoProps } from '@/components/seo/Seo.astro';
import '@/fonts/index.css';
import '@/styles/global.css';
import MotionController from '@/components/motion/MotionController.astro';

interface Props extends SeoProps {
  smoothScroll?: boolean;
  motion?: boolean;
}
const { smoothScroll = false, motion = false, ...seo } = Astro.props;
---

<!doctype html>
<html lang={seo.locale ?? 'el'}>
  <head>
    <Seo {...seo} />
    <slot name="head" />
  </head>
  <body data-smooth-scroll={smoothScroll ? '' : undefined}>
    <a class="skip-link" href="#main-content">
      {seo.locale === 'en' ? 'Skip to content' : 'Μετάβαση στο περιεχόμενο'}
    </a>
    <slot />
    {(smoothScroll || motion) && <MotionController />}
  </body>
</html>

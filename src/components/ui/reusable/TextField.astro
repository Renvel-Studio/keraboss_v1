---
interface Props {
  id: string;
  label: string;
  name?: string;
  type?: 'text' | 'email';
  value?: string;
  placeholder?: string;
  message?: string;
  state?: 'default' | 'error' | 'success';
  required?: boolean;
  disabled?: boolean;
  autocomplete?: string;
}
const {
  id,
  label,
  name = id,
  type = 'text',
  value,
  placeholder,
  message,
  state = 'default',
  required = false,
  disabled = false,
  autocomplete = 'off',
} = Astro.props;
---

<div class="field">
  <label class="field-label" for={id}>
    {label}
    {required && <span aria-hidden="true"> *</span>}
  </label>
  <input
    class="control"
    id={id}
    name={name}
    type={type}
    value={value}
    placeholder={placeholder}
    required={required}
    disabled={disabled}
    autocomplete={autocomplete}
    aria-describedby={message ? `${id}-message` : undefined}
    aria-invalid={state === 'error' ? 'true' : state === 'success' ? 'false' : undefined}
    data-validated={state === 'success' ? '' : undefined}
  />
  {message && (
    <p
      id={`${id}-message`}
      class:list={['field-message', state !== 'default' && `field-message--${state}`]}
    >
      {state === 'error' && <span aria-hidden="true">! </span>}
      {state === 'success' && <span aria-hidden="true">✓ </span>}
      {message}
    </p>
  )}
</div>

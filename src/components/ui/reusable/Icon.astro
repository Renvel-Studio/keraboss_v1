---
import type { IconName } from '@/generated/icons';

interface Props {
  name: IconName;
  label?: string;
  class?: string;
  size?: number | string;
}
const { name, label, class: className, size = '1.25em' } = Astro.props;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <use href={`/icons/sprite.svg#icon-${name}`} />
</svg>
